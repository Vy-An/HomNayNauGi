generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id_user       Int             @id @default(autoincrement())
  name          String
  email         String          @unique
  password      String
  avatar        String?
  role          Role            @default(USER)
  status        UserStatus      @default(ACTIVE)
  created_at    DateTime        @default(now())
  updated_at    DateTime        @updatedAt
  shoppingLists ShoppingList[]
  favorites     Favorite[]
  posts         Post[]
  comments      Comment[]
  postLikes     PostLike[]
  reports       Report[]
  notifications Notification[]
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model Food {
  id_food         Int               @id @default(autoincrement())
  id_category     Int
  name            String
  slug            String            @unique
  description     String?           @db.Text
  image           String?
  cooking_time    Int?              // in minutes
  servings        Int?
  status          FoodStatus        @default(ACTIVE)
  created_at      DateTime          @default(now())
  updated_at      DateTime          @updatedAt
  category        Category          @relation(fields: [id_category], references: [id_Category])
  foodIngredients FoodIngredient[]
  recipeSteps     RecipeStep[]
  favorites       Favorite[]
  shoppingLists   ShoppingList[]
  posts           Post[]
}

enum FoodStatus {
  ACTIVE
  HIDDEN
}

model Category {
  id_Category Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  foods       Food[]
}

model Ingredient {
  id_ingredient      Int                  @id @default(autoincrement())
  name               String
  unit               String
  created_at         DateTime             @default(now())
  updated_at         DateTime             @updatedAt
  foodIngredients    FoodIngredient[]
  shoppingListItems  ShoppingListItem[]
}

model FoodIngredient {
  id_Food_Ingredient Int        @id @default(autoincrement())
  id_food            Int
  id_ingredient      Int
  quantity           Float
  note               String?
  food               Food       @relation(fields: [id_food], references: [id_food])
  ingredient         Ingredient @relation(fields: [id_ingredient], references: [id_ingredient])
}

model RecipeStep {
  id_Recipe_steps Int    @id @default(autoincrement())
  id_food         Int
  step_number     Int
  instruction     String @db.Text
  food            Food   @relation(fields: [id_food], references: [id_food])
}

model Favorite {
  id_favorites Int      @id @default(autoincrement())
  id_user      Int
  id_food      Int
  created_at   DateTime @default(now())
  user         User     @relation(fields: [id_user], references: [id_user])
  food         Food     @relation(fields: [id_food], references: [id_food])
}

model ShoppingList {
  id_shopping_list Int                @id @default(autoincrement())
  id_user          Int
  id_food          Int?
  created_at       DateTime           @default(now())
  user             User               @relation(fields: [id_user], references: [id_user])
  food             Food?              @relation(fields: [id_food], references: [id_food])
  items            ShoppingListItem[]
}

model ShoppingListItem {
  id_shopping_list_item Int          @id @default(autoincrement())
  id_shopping_list      Int
  id_ingredient         Int
  quantity              Float
  unit                  String
  is_checked            Boolean      @default(false)
  shoppingList          ShoppingList @relation(fields: [id_shopping_list], references: [id_shopping_list])
  ingredient            Ingredient   @relation(fields: [id_ingredient], references: [id_ingredient])
}

model Post {
  id_post    Int        @id @default(autoincrement())
  id_user    Int
  id_food    Int?
  title      String
  content    String     @db.Text
  image      String?
  status     PostStatus @default(PUBLISHED)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  user       User       @relation(fields: [id_user], references: [id_user])
  food       Food?      @relation(fields: [id_food], references: [id_food])
  comments   Comment[]
  likes      PostLike[]
}

enum PostStatus {
  PUBLISHED
  HIDDEN
  DELETED
}

model Comment {
  id_comment Int           @id @default(autoincrement())
  id_post    Int
  id_user    Int
  content    String        @db.Text
  status     CommentStatus @default(ACTIVE)
  created_at DateTime      @default(now())
  updated_at DateTime      @updatedAt
  post       Post          @relation(fields: [id_post], references: [id_post])
  user       User          @relation(fields: [id_user], references: [id_user])
}

enum CommentStatus {
  ACTIVE
  HIDDEN
}

model PostLike {
  id_post_like Int      @id @default(autoincrement())
  id_post      Int
  id_user      Int
  created_at   DateTime @default(now())
  post         Post     @relation(fields: [id_post], references: [id_post])
  user         User     @relation(fields: [id_user], references: [id_user])
}

model Report {
  id_report   Int          @id @default(autoincrement())
  id_user     Int
  target_type String       // "POST", "COMMENT", "USER"
  target_id   Int
  reason      String
  description String?      @db.Text
  status      ReportStatus @default(PENDING)
  created_at  DateTime     @default(now())
  updated_at  DateTime     @updatedAt
  user        User         @relation(fields: [id_user], references: [id_user])
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model Notification {
  id_notification Int      @id @default(autoincrement())
  id_user         Int
  type            String   // "LIKE", "COMMENT", "SYSTEM"
  title           String
  message         String
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())
  user            User     @relation(fields: [id_user], references: [id_user])
}
